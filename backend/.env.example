# Which config file to load: configs/{ENV}.config.yaml, where ENV is
# <env>.<node>. api-control overrides it with local.control in docker-compose.yml.
ENV=local.in

# Reach both Postgres planes through the pgbouncer container instead of
# control-pg/data-pg directly. Read by settings as postgres.proxy; unset it and
# every pool connects directly again, with its statement cache back. See
# pgbouncer/pgbouncer.ini.
TALQING_PG_PROXY=pgbouncer:6432
