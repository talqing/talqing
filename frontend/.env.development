# Loaded ONLY by `next dev` (NODE_ENV=development) — that is your laptop.
#
# NOT the DigitalOcean dev environment. That one is a production build and gets
# its URLs from the Cloudflare Pages dev project. `next build` never reads this
# file.
#
# To run the local dev server against the deployed dev backend instead, set
# these in .env.local, which overrides this.

# The control plane from `docker compose up` at the repo root — identity,
# organizations, tokens, and the region list. One host for the whole deployment.
NEXT_PUBLIC_CONTROL_API_URL=http://localhost:8001

# The build-time copy of the region list. Its shape is exactly what
# `GET /v1/regions` returns, so there is one shape and nothing to keep in sync:
# the dashboard refreshes it from the control plane at runtime and caches it, and
# this is the fallback so a control-plane blip cannot blank the app.
#
# Local runs one region, matching backend/configs/local.control.config.yaml.
NEXT_PUBLIC_REGIONS=[{"slug":"in","name":"India (Bangalore)","api_url":"http://localhost:8000","default":true}]
