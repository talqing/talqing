{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    // Must agree with `resolve.symlinks: false` in next.config.js, and for the
    // same reason: the three @talqing packages are `file:` deps, so resolving
    // their real path reaches a SECOND copy of livekit-client's types and every
    // TrackReference crossing the boundary becomes a different type. Read them
    // through the link and there is one copy, as webpack sees at build time.
    "preserveSymlinks": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next-verify/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
